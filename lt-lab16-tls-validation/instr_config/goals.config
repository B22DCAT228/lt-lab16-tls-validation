untrusted_certificate_rejected = boolean : (_untrusted)
#DOC untrusted_certificate_rejected : Client rejects an untrusted certificate.
hostname_mismatch_rejected = boolean : (_hostname)
#DOC hostname_mismatch_rejected : Client rejects an incorrect hostname.
trusted_ca_accepted = boolean : (_trusted)
#DOC trusted_ca_accepted : HTTPS validation succeeds with the training CA.
subject_alt_name_verified = boolean : (_san)
#DOC subject_alt_name_verified : The expected DNS SAN is verified.
certificate_fingerprint_verified = boolean : (_fingerprint)
#DOC certificate_fingerprint_verified : The server certificate SHA256 fingerprint matches.
tls_version_verified = boolean : (_tls)
#DOC tls_version_verified : TLS 1.2 or TLS 1.3 is negotiated.
https_response_verified = boolean : (_http)
#DOC https_response_verified : The verified HTTPS server returns HTTP 200.
